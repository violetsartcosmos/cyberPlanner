generator client {
  provider        = "prisma-client"
  output          = "../server/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model PlannerDay {
  id      Int      @id @default(autoincrement())
  day     DateTime @unique @db.Date
  checks  Json     @default("[]")
  journal String   @default("")

  @@map("planner_days")
}

model GoogleConnection {
  singleton             Boolean  @id @default(true)
  email                 String
  encryptedRefreshToken String   @map("encrypted_refresh_token")
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("google_connections")
}

model ExternalTask {
  id          Int       @id @default(autoincrement())
  source      String
  externalId  String    @map("external_id")
  taskListId  String?   @map("task_list_id")
  title       String
  dueDate     DateTime? @map("due_date") @db.Date
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  emailFrom   String?   @map("email_from")
  emailUrl    String?   @map("email_url")
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([source, externalId])
  @@index([dueDate], map: "external_tasks_due_date_idx", where: { isDeleted: false })
  @@map("external_tasks")
}

model PointLedger {
  id         BigInt    @id @default(autoincrement())
  amount     Int
  entryType  String    @map("entry_type")
  taskKey    String?   @map("task_key")
  taskDate   DateTime? @map("task_date") @db.Date
  rewardId   String?   @map("reward_id")
  rewardName String?   @map("reward_name")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([taskKey], map: "point_ledger_task_award_idx", where: { entryType: "earn" })
  @@map("point_ledger")
}

model TherapyExercise {
  id           String                   @id
  name         String
  prescription String
  instructions String
  purpose      String
  sessions     TherapySessionExercise[]

  @@map("therapy_exercises")
}

model TherapySession {
  id        String                   @id
  label     String
  title     String
  position  Int                      @unique
  exercises TherapySessionExercise[]

  @@map("therapy_sessions")
}

model TherapySessionExercise {
  id          Int                 @id @default(autoincrement())
  sessionId   String              @map("session_id")
  exerciseId  String              @map("exercise_id")
  position    Int
  points      Int
  session     TherapySession      @relation(fields: [sessionId], references: [id])
  exercise    TherapyExercise     @relation(fields: [exerciseId], references: [id])
  completions TherapyCompletion[]

  @@unique([sessionId, exerciseId])
  @@unique([sessionId, position])
  @@map("therapy_session_exercises")
}

model TherapyCompletion {
  id         Int                    @id @default(autoincrement())
  day        DateTime               @db.Date
  sessionId  String                 @map("session_id")
  exerciseId String                 @map("exercise_id")
  assignment TherapySessionExercise @relation(fields: [sessionId, exerciseId], references: [sessionId, exerciseId])

  @@unique([day, sessionId, exerciseId])
  @@map("therapy_completions")
}

model Achievement {
  id                String    @id @default(uuid())
  title             String
  description       String
  category          String
  tier              String
  xp                Int
  target            Int
  current           Int       @default(0)
  icon              String    @default("award")
  tracking          String    @default("points")
  taskId            String?   @map("task_id")
  milestoneInterval Int?      @map("milestone_interval")
  reward            String    @default("")
  earnedAt          DateTime? @map("unlocked_at") @db.Timestamptz(6)
  awardedXp         Int       @default(0) @map("awarded_xp")
  deleted           Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("achievements")
}

model Quest {
  id          String    @id @default(uuid())
  title       String
  description String    @default("")
  kind        String
  tier        String
  points      Int
  templateId  String?   @unique @map("template_id")
  deleted     Boolean   @default(false)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("quests")
}

model RoutineTask {
  id     Int                @id @default(autoincrement())
  list   String
  title  String
  kind   String
  points Int
  groups RoutineTaskGroup[]

  @@map("routine_tasks")
}

model RoutineGroup {
  id      Int                @id @default(autoincrement())
  weekday String             @unique
  title   String
  message String
  tasks   RoutineTaskGroup[]

  @@map("routine_groups")
}

model RoutineTaskGroup {
  taskId  Int          @map("task_id")
  groupId Int          @map("group_id")
  task    RoutineTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  group   RoutineGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([taskId, groupId])
  @@map("routine_task_groups")
}

model QuestTemplate {
  id          String @id
  track       String
  kind        String
  title       String
  description String @default("")
  tier        String
  points      Int
  position    Int

  @@map("quest_templates")
}

model Book {
  id          String     @id @default(uuid()) @db.Uuid
  library     String
  path        String
  storagePath String     @map("storage_path")
  wikipedia   Json?
  cover       Bytes?
  coverType   String?    @map("cover_type")
  progress    String?
  revision    Int        @default(0)
  bookmarks   Bookmark[]

  @@unique([library, path])
  @@map("books")
}

model Bookmark {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  position  String
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  book      Book     @relation(fields: [bookId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@index([bookId])
  @@map("bookmarks")
}
