{
  "name": "cyberplanner",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config server/vite.config.ts",
    "dev": "concurrently -k -n api,client \"tsx server/index.ts\" \"vite\"",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./build/server/index.js')\"",
    "generate-secrets": "node scripts/generate-secrets.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:database": "node --test tests/database.integration.test.mjs",
    "test:server": "node --test tests/server.test.mjs tests/action-validation.test.mjs",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@hono/node-server": "^2.1.11",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "hono": "^4.0.0",
    "pg": "^8.23.1",
    "prisma": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.0.0",
    "sass": "^1.93.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "tsx": "^4.0.0",
    "vite": "^8.0.3"
  }
}
