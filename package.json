{
  "name": "cyberplanner",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --config server/vite.config.ts",
    "dev": "concurrently -k -n api,client \"tsx server/index.ts\" \"vite\"",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./build/server/index.js')\"",
    "generate-secrets": "node scripts/generate-secrets.mjs",
    "backup:books": "node scripts/backup-books.mjs",
    "backup:audible": "node scripts/backup-books.mjs audiblebooks",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:database": "node --test tests/database.integration.test.mjs",
    "test:profile": "node --import tsx --test tests/profile.test.mjs tests/gamification.test.mjs tests/planner-action.test.mjs",
    "test:books": "node --import tsx --test tests/books.test.mjs tests/book-progress.test.mjs tests/backup-books.test.mjs",
    "test:book-data": "node --import tsx --test tests/book-data.integration.test.mjs tests/book-progress-api.integration.test.mjs",
    "test:server": "node --test tests/server.test.mjs tests/action-validation.test.mjs",
    "lint:hooks": "eslint src --max-warnings 0",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@blocknote/core": "^0.57.0",
    "@blocknote/mantine": "^0.57.0",
    "@blocknote/react": "^0.57.0",
    "@hono/node-server": "^2.1.11",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bootstrap": "^5.3.9",
    "dotenv": "^18.0.10",
    "epubjs": "^0.3.93",
    "googleapis": "^190.0.0",
    "hono": "^4.0.0",
    "lucide-react": "^1.77.0",
    "music-metadata": "^12.8.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "prisma": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-reader": "^2.0.15",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.48.0",
    "concurrently": "^9.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "sass": "^1.93.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    },
    "epubjs": {
      "@xmldom/xmldom": "^0.9.12"
    }
  }
}
